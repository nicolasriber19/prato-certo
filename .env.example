# Modelo do arquivo .env.local (que fica fora do Git).
# Copie este arquivo para .env.local e preencha com os dados do seu projeto no Supabase:
# painel do Supabase → Project Settings → API Keys (e Data API, para a URL).

# Endereço do projeto, no formato https://<id-do-projeto>.supabase.co
VITE_SUPABASE_URL=

# Chave "publishable" (começa com sb_publishable_) ou a chave "anon" antiga.
# Ela pode ficar no site: quem protege os dados são as regras de supabase/schema.sql.
# NUNCA use aqui a chave "secret" ou "service_role".
VITE_SUPABASE_PUBLISHABLE_KEY=
